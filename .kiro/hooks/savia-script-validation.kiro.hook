{
  "enabled": true,
  "name": "SAVIA Script Validation",
  "description": "Automatically verify deployment scripts before they are used to ensure they work correctly",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "deploy_standardized.sh",
      "quick_fix.sh",
      "diagnose_deployment.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A deployment script was just edited. Verify the script syntax and logic are correct. Check for: 1) Proper error handling, 2) Correct variable usage, 3) Safe command execution, 4) Proper logging. If there are any issues, suggest fixes."
  }
}