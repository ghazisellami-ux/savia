{
  "enabled": false,
  "name": "SAVIA Pre-Push Deployment Check",
  "description": "Manually test the application",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before pushing code or commiting any change, prompt the user to locally test the application, and wait for his final confirmation wether to proceed or not."
  },
  "workspaceFolderName": "savia-next",
  "shortName": "savia-pre-push-check"
}