{
  "version": "1.0.0",
  "enabled": true,
  "name": "db sans -v",
  "description": "éviter d'utiliser -v dans les commande docker pour ne pas effacer la base de donnée",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "ne  jamais utiliser -v dans une commande sans me demander la permission "
  },
  "workspaceFolderName": "savia-next",
  "shortName": "db"
}