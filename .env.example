NODE_ENV = "development"

# ── PostgreSQL ────────────────────────────
POSTGRES_DB=savia_db
POSTGRES_USER=savia_user
POSTGRES_PASSWORD=your_secure_password_here

# ── MinIO (Object Storage S3-compatible) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# ── Backend (FastAPI) ─────────────────────
JWT_SECRET=your_jwt_secret_key_here
PORT=8001

# ── S3 / MinIO (utilisé par le backend) ───
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=your_minio_password_here
S3_BUCKET=savia-logs
S3_REGION=us-east-1

# ── Google Gemini AI ──────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_API_KEYS=your_google_api_key_here

# ── Sécurité ──────────────────────────────
MASTER_KEY=your_master_key_here
ACCESS_CODE=your_access_code_here

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001
BACKEND_URL=http://backend:8001
