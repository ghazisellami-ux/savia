NODE_ENV = "development"

# ── PostgreSQL ────────────────────────────
POSTGRES_DB=savia_db
POSTGRES_USER=savia_user
POSTGRES_PASSWORD=your_secure_password_here

# ── MinIO (Object Storage S3-compatible) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_minio_password_here

# ── Backend (FastAPI) ─────────────────────
# Obligatoire : générer une valeur aléatoire d'au moins 32 octets, par exemple avec
# `openssl rand -base64 48` (ne jamais conserver une valeur d'exemple en production).
JWT_SECRET=
# Durée de session en heures (1 à 72, 24 recommandé).
JWT_EXPIRY_HOURS=24
# Production : liste des origines explicitement autorisées, séparées par des virgules.
# Exemple : https://app.exemple.tn,https://pwa.exemple.tn
# Set this value for each client deployment; never use *.
# Example: https://app.client.tn,https://site.client.tn
CORS_ORIGINS=
# Utilisé uniquement pour initialiser une base vide. Retirez ces deux variables
# après la création du premier administrateur ; ne mettez jamais admin/admin.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Durée maximale d'utilisation d'un mot de passe avant changement obligatoire.
PASSWORD_ROTATION_DAYS=90
PORT=8001

# ── S3 / MinIO (utilisé par le backend) ───
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=your_minio_password_here
S3_BUCKET=savia-logs
S3_REGION=us-east-1
# Maximum accepted upload sizes. New signed fiches and technical documents are
# stored privately in MinIO/S3; their object names are generated by the server.
MAX_FICHE_SIZE_MB=10
MAX_DOCUMENT_TECHNIQUE_SIZE_MB=20
MAX_LOG_SIZE_MB=10

# Exploitation : logs JSON et accès protégé aux métriques Prometheus.
# Générer une valeur longue et aléatoire, distincte du JWT. Ne jamais l'exposer
# dans le navigateur ; elle est réservée à l'outil de supervision.
LOG_LEVEL=INFO
METRICS_TOKEN=
# Point de surveillance de la capacité du volume backend.
OBS_DATA_PATH=/app/data
# Alert thresholds are exposed as Prometheus metrics. 0 disables the database
# size alert; the external monitor decides where to send notifications.
OBS_DISK_ALERT_PERCENT=85
OBS_DB_ALERT_BYTES=0

# ── Google Gemini AI ──────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_API_KEYS=your_google_api_key_here

# ── Sécurité ──────────────────────────────
MASTER_KEY=your_master_key_here
ACCESS_CODE=your_access_code_here

# ── Frontend ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001
BACKEND_URL=http://backend:8001
